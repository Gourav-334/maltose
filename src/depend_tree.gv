digraph Assembler
{
	/* Layouts & configurations. */

	rankdir = TB;
	ranksep = 3.0;
	fontsize = 14;










	/* All the nodes. */

	// Binary generator

	specs_assign [fontsize=32, width=1.5, height=1.0, label="Specs Assigner", shape=box, fillcolor=maroon1, style=filled];
	specs_store [fontsize=32, width=1.5, height=1.0, label="Specs Storehouse", shape=box, fillcolor=maroon1, style=filled];
	bin_sec_store [fontsize=32, width=1.5, height=1.0, label="Specs Storehouse", shape=box, fillcolor=maroon1, style=filled];



	// Command interpreter

	cmd_fsm0 [fontsize=32, width=1.5, height=1.0, label="Command FSM0", shape=box, fillcolor=skyblue, style=filled];
	cmd_fsm1 [fontsize=32, width=1.5, height=1.0, label="Command FSM1", shape=box, fillcolor=skyblue, style=filled];
	cmd_fsm_main [fontsize=32, width=1.5, height=1.0, label="Command FSM Main", shape=box, fillcolor=skyblue, style=filled];
	cmd_valid [fontsize=32, width=1.5, height=1.0, label="Command Validator", shape=box, fillcolor=skyblue, style=filled];
	flag_status [fontsize=32, width=1.5, height=1.0, label="Flag Status", shape=box, fillcolor=skyblue, style=filled];
	cmd_fsm_handler [fontsize=32, width=1.5, height=1.0, label="Command FSM Handler", shape=box, fillcolor=skyblue, style=filled];



	// Data structures

	ht_dropper [fontsize=32, width=1.5, height=1.0, label="HT Entry Dropper", shape=box, fillcolor=orange, style=filled];
	ht_fetcher [fontsize=32, width=1.5, height=1.0, label="HT Entry Fetcher", shape=box, fillcolor=orange, style=filled];
	ht_inserter [fontsize=32, width=1.5, height=1.0, label="HT Entry Inserter", shape=box, fillcolor=orange, style=filled];
	ht_struct [fontsize=32, width=1.5, height=1.0, label="HT Structure", shape=box, fillcolor=orange, style=filled];

	displayer [fontsize=32, width=1.5, height=1.0, label="LL Displayer", shape=box, fillcolor=orange, style=filled];
	full_remover [fontsize=32, width=1.5, height=1.0, label="LL Full Remover", shape=box, fillcolor=orange, style=filled];
	inserter [fontsize=32, width=1.5, height=1.0, label="LL Node Inserter", shape=box, fillcolor=orange, style=filled];
	ll_struct [fontsize=32, width=1.5, height=1.0, label="LL Structure", shape=box, fillcolor=orange, style=filled];
	remover [fontsize=32, width=1.5, height=1.0, label="LL Node Remover", shape=box, fillcolor=orange, style=filled];



	// Lexer

	token_fsm0 [fontsize=32, width=1.5, height=1.0, label="Token FSM 0", shape=box, fillcolor=yellow, style=filled];
	token_fsm1 [fontsize=32, width=1.5, height=1.0, label="Token FSM 1", shape=box, fillcolor=yellow, style=filled];
	token_fsm2 [fontsize=32, width=1.5, height=1.0, label="Token FSM 2", shape=box, fillcolor=yellow, style=filled];
	code_cleanser [fontsize=32, width=1.5, height=1.0, label="Code Cleanser", shape=box, fillcolor=yellow, style=filled];
	token_fsm_handler [fontsize=32, width=1.5, height=1.0, label="Token FSM Handler", shape=box, fillcolor=yellow, style=filled];
	token_fsm_main [fontsize=32, width=1.5, height=1.0, label="Token FSM Main", shape=box, fillcolor=yellow, style=filled];
	token_recog [fontsize=32, width=1.5, height=1.0, label="Token Recognizer", shape=box, fillcolor=yellow, style=filled];
	token_store [fontsize=32, width=1.5, height=1.0, label="Token Storehouse", shape=box, fillcolor=yellow, style=filled];



	// Manuals

	audit_msng [fontsize=32, width=1.5, height=1.0, label="Audit Messenger", shape=box, fillcolor=green, style=filled];
	cmd_help [fontsize=32, width=1.5, height=1.0, label="Command Helper", shape=box, fillcolor=green, style=filled];



	// Parser

	patt_fsm0 [fontsize=32, width=1.5, height=1.0, label="Pattern FSM", shape=box, fillcolor=red1, style=filled];
	patt_fsm_main [fontsize=32, width=1.5, height=1.0, label="Pattern FSM Main", shape=box, fillcolor=red1, style=filled];
	patt_fsm_handler [fontsize=32, width=1.5, height=1.0, label="Pattern FSM Main", shape=box, fillcolor=red1, style=filled];
	register_store [fontsize=32, width=1.5, height=1.0, label="Register Storehouse", shape=box, fillcolor=red1, style=filled];
	section_store [fontsize=32, width=1.5, height=1.0, label="Section Storehouse", shape=box, fillcolor=red1, style=filled];
	label_store [fontsize=32, width=1.5, height=1.0, label="Label Storehouse", shape=box, fillcolor=red1, style=filled];
	parser_fsm0 [fontsize=32, width=1.5, height=1.0, label="Parser FSM", shape=box, fillcolor=red1, style=filled];
	parser_fsm_main [fontsize=32, width=1.5, height=1.0, label="Parser FSM Main", shape=box, fillcolor=red1, style=filled];
	parser_state_handler [fontsize=32, width=1.5, height=1.0, label="Parser FSM Main", shape=box, fillcolor=red1, style=filled];



	// Utilities

	path_valid [fontsize=32, width=1.5, height=1.0, label="Path Validator", shape=box, fillcolor=pink, style=filled];

	pop_dealloc [fontsize=32, width=1.5, height=1.0, label="Pop Deallocator", shape=box, fillcolor=pink, style=filled];
	push_alloc [fontsize=32, width=1.5, height=1.0, label="Push Allocator", shape=box, fillcolor=pink, style=filled];

	case_ins_matcher [fontsize=32, width=1.5, height=1.0, label="Case Insensitive Matcher", shape=box, fillcolor=pink, style=filled];
	ill_char_scan [fontsize=32, width=1.5, height=1.0, label="Illegal Character Scanner", shape=box, fillcolor=pink, style=filled];



	// Central files

	common_store [fontsize=32, width=1.5, height=1.0, label="Common Storehouse", shape=box, fillcolor=gray, style=filled];
	file_loader [fontsize=32, width=1.5, height=1.0, label="File Loader", shape=box, fillcolor=gray, style=filled];
	main [fontsize=32, width=1.5, height=1.0, label="Main Program", shape=box, fillcolor=gray, style=filled];
	test [fontsize=32, width=1.5, height=1.0, label="Test Program", shape=box, fillcolor=gray, style=filled];










	/* Drawing edges among nodes. */

	// Binary generator

	specs_store -> specs_assign [fontsize=32, width=1.5, height=1.0, label="Changing stores specs", color=black, style=solid, fontcolor=black, arrowhead=normal];



	// Command interpreter

	cmd_fsm0 -> cmd_fsm_main [fontsize=32, width=1.5, height=1.0, label="Joining FSM parts", color=black, style=solid, fontcolor=black, arrowhead=normal];
	cmd_fsm1 -> cmd_fsm_main [fontsize=32, width=1.5, height=1.0, label="Joining FSM parts", color=black, style=solid, fontcolor=black, arrowhead=normal];
	cmd_fsm_handler -> cmd_fsm_main [fontsize=32, width=1.5, height=1.0, label="Joining state handler", color=black, style=solid, fontcolor=black, arrowhead=normal];
	cmd_fsm_main -> cmd_valid [fontsize=32, width=1.5, height=1.0, label="Assembling whole FSM", color=black, style=solid, fontcolor=black, arrowhead=normal];
	ill_char_scan -> cmd_valid [fontsize=32, width=1.5, height=1.0, label="Scans illegal chars", color=black, style=solid, fontcolor=black, arrowhead=normal];
	path_valid -> cmd_valid [fontsize=32, width=1.5, height=1.0, label="Verifies paths", color=black, style=solid, fontcolor=black, arrowhead=normal];
	flag_status -> cmd_fsm_handler [fontsize=32, width=1.5, height=1.0, label="Manipulates flags", color=black, style=solid, fontcolor=black, arrowhead=normal];



	// Data structures

	ht_struct -> ht_fetcher [fontsize=32, width=1.5, height=1.0, label="Using HT struct", color=black, style=solid, fontcolor=black, arrowhead=normal];
	ht_struct -> ht_inserter [fontsize=32, width=1.5, height=1.0, label="Using HT struct", color=black, style=solid, fontcolor=black, arrowhead=normal];
	ht_struct -> ht_dropper [fontsize=32, width=1.5, height=1.0, label="Using HT struct", color=black, style=solid, fontcolor=black, arrowhead=normal];
	common_store -> ht_fetcher [fontsize=32, width=1.5, height=1.0, label="Using HT struct", color=black, style=solid, fontcolor=black, arrowhead=normal];
	common_store -> ht_inserter [fontsize=32, width=1.5, height=1.0, label="Using HT struct", color=black, style=solid, fontcolor=black, arrowhead=normal];
	
	ll_struct -> displayer [fontsize=32, width=1.5, height=1.0, label="Using LL struct", color=black, style=solid, fontcolor=black, arrowhead=normal];
	ll_struct -> full_remover [fontsize=32, width=1.5, height=1.0, label="Using LL struct", color=black, style=solid, fontcolor=black, arrowhead=normal];
	remover -> full_remover [fontsize=32, width=1.5, height=1.0, label="Iterative removal", color=black, style=solid, fontcolor=black, arrowhead=normal];
	ll_struct -> inserter [fontsize=32, width=1.5, height=1.0, label="Using LL struct", color=black, style=solid, fontcolor=black, arrowhead=normal];
	ll_struct -> remover [fontsize=32, width=1.5, height=1.0, label="Using LL struct", color=black, style=solid, fontcolor=black, arrowhead=normal];



	// Lexer

	ll_struct -> token_store [fontsize=32, width=1.5, height=1.0, label="construct LL", color=black, style=solid, fontcolor=black, arrowhead=normal];
	common_store -> token_fsm0 [fontsize=32, width=1.5, height=1.0, label="Stores FSM condition", color=black, style=solid, fontcolor=black, arrowhead=normal];
	common_store -> token_fsm1 [fontsize=32, width=1.5, height=1.0, label="Stores FSM condition", color=black, style=solid, fontcolor=black, arrowhead=normal];
	common_store -> token_fsm2 [fontsize=32, width=1.5, height=1.0, label="Stores FSM condition", color=black, style=solid, fontcolor=black, arrowhead=normal];
	common_store -> code_cleanser [fontsize=32, width=1.5, height=1.0, label="Knows FSM condition", color=black, style=solid, fontcolor=black, arrowhead=normal];
	ll_struct -> code_cleanser [fontsize=32, width=1.5, height=1.0, label="Manipulates LL", color=black, style=solid, fontcolor=black, arrowhead=normal];
	inserter -> code_cleanser [fontsize=32, width=1.5, height=1.0, label="Inserts LL nodes", color=black, style=solid, fontcolor=black, arrowhead=normal];
	token_recog -> code_cleanser [fontsize=32, width=1.5, height=1.0, label="Calls recognizer", color=black, style=solid, fontcolor=black, arrowhead=normal];
	token_store -> code_cleanser [fontsize=32, width=1.5, height=1.0, label="Stores tokens", color=black, style=solid, fontcolor=black, arrowhead=normal];
	audit_msng -> code_cleanser [fontsize=32, width=1.5, height=1.0, label="Terminal display", color=black, style=solid, fontcolor=black, arrowhead=normal];
	ill_char_scan -> code_cleanser [fontsize=32, width=1.5, height=1.0, label="Checks for illegal chars", color=black, style=solid, fontcolor=black, arrowhead=normal];
	push_alloc -> code_cleanser [fontsize=32, width=1.5, height=1.0, label="Dynamically pushing char", color=black, style=solid, fontcolor=black, arrowhead=normal];
	pop_dealloc -> code_cleanser [fontsize=32, width=1.5, height=1.0, label="Dynamically popping char", color=black, style=solid, fontcolor=black, arrowhead=normal];
	file_loader -> code_cleanser [fontsize=32, width=1.5, height=1.0, label="Loading fstream", color=black, style=solid, fontcolor=black, arrowhead=normal];
	common_store -> token_fsm_handler [fontsize=32, width=1.5, height=1.0, label="Reads FSM condition", color=black, style=solid, fontcolor=black, arrowhead=normal];
	token_store -> token_fsm_handler [fontsize=32, width=1.5, height=1.0, label="Stores tokens", color=black, style=solid, fontcolor=black, arrowhead=normal];
	ll_struct -> token_fsm_handler [fontsize=32, width=1.5, height=1.0, label="Using LL", color=black, style=solid, fontcolor=black, arrowhead=normal];
	inserter -> token_fsm_handler [fontsize=32, width=1.5, height=1.0, label="Pushing validated tokens", color=black, style=solid, fontcolor=black, arrowhead=normal];
	file_loader -> token_fsm_handler [fontsize=32, width=1.5, height=1.0, label="Extracting line from fstream", color=black, style=solid, fontcolor=black, arrowhead=normal];
	audit_msng -> token_fsm_handler [fontsize=32, width=1.5, height=1.0, label="Feedback on terminal", color=black, style=solid, fontcolor=black, arrowhead=normal];
	common_store -> token_fsm_main [fontsize=32, width=1.5, height=1.0, label="Accessing FSM conditions", color=black, style=solid, fontcolor=black, arrowhead=normal];
	token_fsm0 -> token_fsm_main [fontsize=32, width=1.5, height=1.0, label="Joining FSM parts", color=black, style=solid, fontcolor=black, arrowhead=normal];
	token_fsm1 -> token_fsm_main [fontsize=32, width=1.5, height=1.0, label="Joining FSM parts", color=black, style=solid, fontcolor=black, arrowhead=normal];
	token_fsm2 -> token_fsm_main [fontsize=32, width=1.5, height=1.0, label="Joining FSM parts", color=black, style=solid, fontcolor=black, arrowhead=normal];
	token_fsm_handler -> token_fsm_main [fontsize=32, width=1.5, height=1.0, label="Assembling state handler", color=black, style=solid, fontcolor=black, arrowhead=normal];
	case_ins_matcher -> token_recog [fontsize=32, width=1.5, height=1.0, label="Case-insensitive matching", color=black, style=solid, fontcolor=black, arrowhead=normal];
	inserter -> token_recog [fontsize=32, width=1.5, height=1.0, label="Inserting recognized tokens", color=black, style=solid, fontcolor=black, arrowhead=normal];
	token_store -> token_recog [fontsize=32, width=1.5, height=1.0, label="Storing recognized tokens", color=black, style=solid, fontcolor=black, arrowhead=normal];
	token_fsm_main -> token_recog [fontsize=32, width=1.5, height=1.0, label="Assembling token recognizer", color=black, style=solid, fontcolor=black, arrowhead=normal];



	// Manuals

	push_alloc -> audit_msng [fontsize=32, width=1.5, height=1.0, label="Pushing chars to auditer", color=black, style=solid, fontcolor=black, arrowhead=normal];



	// Parser

	ll_struct -> section_store [fontsize=32, width=1.5, height=1.0, label="Storing addresses to sections", color=black, style=solid, fontcolor=black, arrowhead=normal];
	ll_struct -> patt_fsm0 [fontsize=32, width=1.5, height=1.0, label="Storing addresses to sections", color=black, style=solid, fontcolor=black, arrowhead=normal];
	section_store -> patt_fsm0 [fontsize=32, width=1.5, height=1.0, label="Storing addresses to sections", color=black, style=solid, fontcolor=black, arrowhead=normal];
	ll_struct -> patt_fsm_main [fontsize=32, width=1.5, height=1.0, label="Storing addresses to sections", color=black, style=solid, fontcolor=black, arrowhead=normal];
	patt_fsm0 -> patt_fsm_main [fontsize=32, width=1.5, height=1.0, label="Storing addresses to sections", color=black, style=solid, fontcolor=black, arrowhead=normal];
	patt_fsm_handler -> patt_fsm_main [fontsize=32, width=1.5, height=1.0, label="Storing addresses to sections", color=black, style=solid, fontcolor=black, arrowhead=normal];
	token_store -> patt_fsm_main [fontsize=32, width=1.5, height=1.0, label="Storing addresses to sections", color=black, style=solid, fontcolor=black, arrowhead=normal];
	ll_struct -> patt_fsm_handler [fontsize=32, width=1.5, height=1.0, label="Storing addresses to sections", color=black, style=solid, fontcolor=black, arrowhead=normal];
	common_store -> patt_fsm0 [fontsize=32, width=1.5, height=1.0, label="Storing addresses to sections", color=black, style=solid, fontcolor=black, arrowhead=normal];
	common_store -> patt_fsm_handler [fontsize=32, width=1.5, height=1.0, label="Storing addresses to sections", color=black, style=solid, fontcolor=black, arrowhead=normal];
	token_store -> patt_fsm0 [fontsize=32, width=1.5, height=1.0, label="Storing addresses to sections", color=black, style=solid, fontcolor=black, arrowhead=normal];
	file_loader -> patt_fsm_handler [fontsize=32, width=1.5, height=1.0, label="Storing addresses to sections", color=black, style=solid, fontcolor=black, arrowhead=normal];
	ll_struct -> parser_fsm_main [fontsize=32, width=1.5, height=1.0, label="Recognizing linked list rules", color=black, style=solid, fontcolor=black, arrowhead=normal];
	parser_fsm0 -> parser_fsm_main [fontsize=32, width=1.5, height=1.0, label="Assembling 1st parser part", color=black, style=solid, fontcolor=black, arrowhead=normal];
	parser_state_handler -> parser_fsm_main [fontsize=32, width=1.5, height=1.0, label="Assembling parser state handler", color=black, style=solid, fontcolor=black, arrowhead=normal];
	token_store -> parser_fsm_main [fontsize=32, width=1.5, height=1.0, label="Accessing token lists for analysis", color=black, style=solid, fontcolor=black, arrowhead=normal];
	section_store -> parser_fsm_main [fontsize=32, width=1.5, height=1.0, label="Accessing pointer shortcuts", color=black, style=solid, fontcolor=black, arrowhead=normal];



	// Utilities

	push_alloc -> path_valid [fontsize=32, width=1.5, height=1.0, label="Pushing chars to pathname", color=black, style=solid, fontcolor=black, arrowhead=normal];
	push_alloc -> ill_char_scan [fontsize=32, width=1.5, height=1.0, label="Scanning illegal chars", color=black, style=solid, fontcolor=black, arrowhead=normal];



	// Central files

	cmd_valid -> main [fontsize=32, width=1.5, height=1.0, label="Assembling command interpreter", color=black, style=solid, fontcolor=black, arrowhead=normal];










	/* CLustering of similar components. */

	subgraph bin_gen {
		label="Binary Generator";
		style=dashed;
		specs_assign; specs_store; bin_sec_store;
	};



	subgraph cmd_interp {
		label="Command Interpreter";
		style=dashed;
		cmd_fsm0; cmd_fsm1; cmd_fsm_main; cmd_fsm_handler; cmd_valid; cmd_help;
	};



	subgraph data_structures {
		label="Data Structures";
		style=dashed;
		ht_struct; ht_dropper; ht_struct; ht_fetcher; ht_inserter; ll_struct; displayer; full_remover; remover; inserter;
	};



	subgraph lexer {
		label="Lexer";
		style=dashed;
		token_store; token_recog; token_fsm0; token_fsm1; token_fsm2; token_recog; token_fsm_handler; code_cleanser;
	};



	subgraph manuals {
		label="Manuals";
		style=dashed;
		audit_msng; cmd_help;
	};



	subgraph parser {
		label="Parser";
		style=dashed;
		patt_fsm0; register_store; section_store;
	};



	subgraph utils {
		label="Utilities";
		style=dashed;
		path_valid; pop_dealloc; push_alloc; case_ins_matcher; ill_char_scan;
	};
}